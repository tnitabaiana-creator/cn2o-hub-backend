# ===== Hub de Protocolo CN2O =====
PORT=3000
# HUB_KEY — não é mais usada desde a v1.39.2 (pode apagar da Railway).
# v1.39.2 — sites que podem chamar a API pelo navegador (vírgulas). Padrão: o site do Hub.
# CORS_ORIGENS=https://cn2o-hub.netlify.app
# v1.39.1 — emergência (opcional): código de primeiro acesso só para os administradores
# (HUB_ADMINS), com 16+ caracteres. Use quando o Tabelião ficar sem acesso e apague depois.
# HUB_CODIGO_ADMIN=

# Postgres (Railway preenche DATABASE_URL sozinho ao adicionar o plugin)
DATABASE_URL=

# Semente da numeração: ULTIMO PROTOCOLO MANUAL + 1 (usada só na 1ª execução)
PROTOCOLO_INICIAL=1330

# Trello (https://trello.com/power-ups/admin -> chave; token via link "Token")
TRELLO_KEY=
TRELLO_TOKEN=

# IDs (objectId curto, sem o prefixo ari:) — o setup.js imprime todos
BOARD_00=692e0379fa55156e778f27ef
BOARD_01=692e06a94b807c2a1816d992
BOARDS_ESCREVENTES=692e076f5485a0cbb533fe61,692e084cec9c0b8b5eb304d3,692e095e6ca879a15d5ee852,692e0a12a6941ed8d023177f,69ee446f4480af4b9688554a
LISTA_ENTRADA=            # id da lista "Protocolo/Entrada" (setup.js imprime)
LISTA_VENDEDORES=6a91fb6b2a059ddf99973f07   # ⚙ Vendedores Corporativos
LISTA_CORRETORES=6a97348a7a367a1fe16ecf7e   # ⚙ Corretores
LISTA_ADVOGADOS=6a973ef43ecf43a7f8cfc1ae    # ⚙ Advogados

# WhatsApp — plataforma intermediária (Meta Cloud API)
WHATS_URL=https://graph.facebook.com/v22.0/SEU_PHONE_NUMBER_ID/messages
WHATS_TOKEN=
# Nome do template aprovado na Meta:
#   recibo_protocolo_2 -> 1 variável: {{1}} protocolo
#   recibo_protocolo_3 -> 5 variáveis: {{1}} protocolo, {{2}} ato, {{3}} apres, {{4}} parte, {{5}} vendedor
WHATS_TEMPLATE_RECIBO=recibo_protocolo_2
# WHATS_VARIAVEIS_QTD=1 # (opcional) override da quantidade de variáveis caso use outro nome

# URL pública deste serviço (para registrar webhooks do Trello)
BASE_URL=https://SEU-SERVICO.up.railway.app

# v1.36 — CERT (pedido de certidão/traslado). Os padrões já apontam para o quadro real;
# só preencha para trocar.
# BOARD_04=6a8ca1ddc8f6574231ab8ab0            # 04. Certidões/Traslado
# LISTA_TRIAGEM_CERT=6a8cbff5e564123504996c60  # Triagem Certidões/Traslado
# HUB_SITE=https://cn2o-hub.netlify.app         # link do anexo no cartão (anexo.html)
# HUB_CERT_ANEXO_DIAS=180                       # guarda do anexo vinculado a protocolo

# v1.37.1 — recibo próprio do CERT no WhatsApp (ver backend/recibo-cert.js)
# WHATS_TEMPLATE_CERT=recibo_certidao_1   # nome do template APROVADO pela Meta; sem ela o CERT usa o recibo comum
# WHATS_WABA_ID=                          # id da conta do WhatsApp Business — permite cadastrar o template pela API (POST /hub/admin/whats/template-cert)

# v1.38 — relatórios das escreventes (rastreio do Trello + e-mail semanal/mensal). Ver RELATORIOS.md.
# Segredo da MESMA chave TRELLO_KEY (trello.com/power-ups/admin → a chave → "Segredo"). Confere a
# assinatura do webhook; sem ele NADA entra nos relatórios (a re-hidratação dos campos segue igual).
TRELLO_SECRET=
# TRELLO_WEBHOOK_URL=      # só se o webhook foi registrado com URL diferente de BASE_URL/webhook/trello
# RELATORIOS_ADMINS=       # logins que veem os relatórios (vírgulas); sem ela, valem os HUB_ADMINS
# E-mail — o primeiro configurado vale:
#  1) Apps Script da serventia (apps-script/EnviarRelatorio.gs)
RELATORIO_EMAIL_WEBAPP_URL=
RELATORIO_EMAIL_SECRET=
#  2) Resend (API HTTP): RESEND_API_KEY= e RELATORIO_EMAIL_DE=CN2O Relatórios <relatorios@seu-dominio>
#  3) só gravar em arquivo, para conferir: RELATORIO_EMAIL_PROVEDOR=arquivo  (RELATORIO_SAIDA_DIR=relatorios-saida)
# Destinatários (vírgulas). VAZIO = HOMOLOGAÇÃO: vai só para sergiolagofula2@gmail.com
RELATORIO_EMAIL_PARA=
# Horas úteis
# EXPEDIENTE=08:00-12:00,13:00-17:00
# FERIADOS_EXTRA=          # MM-DD (todo ano: municipais) ou AAAA-MM-DD (avulso), por vírgula
# RELATORIOS_AGENDADOR=desligado   # só numa segunda instância do serviço

# v1.39 — atendimentos do balcão (NextQS), sem n8n. Ver RELATORIOS.md → "Atendimentos".
# Token do Next Manager → API (o mesmo da credencial "NextQS API" que o n8n usava).
# Sem ele, a aba mostra só o que já estiver gravado e a coleta das 17h não roda.
NEXTQS_TOKEN=
# NEXTQS_API_URL=https://api.nextqs.com/v1

# v1.39.3 — freio da IA (Hub e Plataforma de Agentes), por pessoa. Ver README, "IA e prompt injection".
# HUB_IA_LIMITE=15          # análises a cada 10 min
# HUB_IA_TETO_DIA_USD=5     # teto diário estimado, em dólar (tabela consumo, fuso de Sergipe)
# HUB_GERADOR_LIBERADO=1    # libera o Gerador de Minuta para a equipe; sem ela, só o Tabelião

# v1.39.4 — dados pessoais. Ver README, "Dados pessoais".
# HUB_MINUTAS_DIAS=90       # minutas guardadas no Hub são apagadas depois deste prazo

# v1.40 — Relatórios · Produtividade em reais. Ver RELATORIOS.md, "Produtividade em reais".
# (a análise do mês usa o modelo único — ver GEMINI_MODELO_UNICO)
# (dias úteis: o São João, 24/06, não está no calendário do Hub — some 06-24 ao FERIADOS_EXTRA acima)

# v1.40.1 — economia: TODA chamada de IA (Hub, Plataforma de Agentes e produtividade) usa um
# modelo só. As antigas HUB_MODELO_* e GEMINI_MODEL_* não valem mais e podem ser apagadas.
# GEMINI_MODELO_UNICO=gemini-3.8-flash
